{
  "name": "momo-source",
  "productName": "MOMO",
  "version": "0.1.0",
  "engines": {
    "node": ">=26.11.1 <27",
    "pnpm": ">=10.17.0"
  },
  "private": true,
  "description": "MOMO roleplay web application",
  "scripts": {
    "generate:model-snapshot": "pnpm exec tsx scripts/generate-model-snapshot.ts",
    "build": "vite build --config vite.config.web.ts && node scripts/build-product-host.mjs",
    "dev": "vite --config vite.config.web.ts",
    "dev:local": "cross-env USE_LOCAL_API=true pnpm start",
    "dev:web": "pnpm dev",
    "dev:web:standalone": "pnpm dev",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration --testTimeout=300000",
    "test:file-conversation": "vitest run test/integration/file-conversation --testTimeout=120000",
    "test:model-provider": "cross-env RUN_MODEL_PROVIDER_TESTS=1 vitest run test/integration/model-provider --testTimeout=120000",
    "test:claude-prompt-cache-live": "cross-env RUN_MODEL_PROVIDER_TESTS=1 RUN_CLAUDE_PROMPT_CACHE_LIVE=1 vitest run test/integration/model-provider/claude-prompt-cache-live.test.ts --testTimeout=180000",
    "eval:session-rag": "node scripts/session-rag-eval/run-session-rag-eval.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "node scripts/generate-routes.mjs && node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "check:packages": "pnpm --filter @chatbox/core check && pnpm --filter @chatbox/react check",
    "format": "biome format --write",
    "check:biome": "biome check",
    "check:ci": "biome ci",
    "check:shared-boundaries": "node scripts/check-shared-boundaries.mjs",
    "prepare": "node -e \"try { require('husky') } catch(e) { process.exit(0) }\" && husky || true",
    "check:error-i18n-keys": "node script/sync-error-i18n-keys.mjs --check",
    "sync:error-i18n-keys": "node script/sync-error-i18n-keys.mjs",
    "translate": "pnpm run sync:error-i18n-keys && i18next && node script/translate.mjs",
    "storybook": "cross-env NODE_OPTIONS=\"--require=./.storybook/ignore-root-env.cjs\" storybook dev -p 6006",
    "build-storybook": "cross-env NODE_OPTIONS=\"--require=./.storybook/ignore-root-env.cjs\" storybook build",
    "start": "pnpm dev",
    "build:web": "pnpm build",
    "preview": "vite preview --config vite.config.web.ts",
    "serve:web": "pnpm preview",
    "check:web": "node scripts/check-web-boundaries.mjs",
    "test:product": "tsx --test test/product/*.test.ts",
    "test:product:resources": "tsx test/product/resources.integration.ts",
    "test:product:spaces": "tsx test/product/spaces.integration.ts"
  },
