{
  "name": "momo-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "remix vite:dev --host 127.0.0.1",
    "build": "remix vite:build && node scripts/build-desktop.mjs",
    "desktop": "electron dist-electron/main.cjs",
    "package": "node scripts/package.mjs",
    "start": "remix-serve build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.25",
    "@remix-run/express": "2.17.5",
    "@remix-run/node": "2.17.5",
    "@remix-run/react": "2.17.5",
    "@remix-run/serve": "2.17.5",
    "express": "4.21.2",
    "isbot": "4.4.0",
    "lucide-react": "1.53.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "9.39.1",
    "@remix-run/dev": "2.17.5",
    "@types/express": "4.17.21",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "electron": "44.7.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  }
}
